# Application
DEBUG=true
APP_NAME=SkyDump AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api

# Database - Use SQLite for local development, PostgreSQL for production
DATABASE_URL=sqlite:///./skydump.db

# STAC API
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
SENTINEL2_COLLECTION=sentinel-2-l2a
MAX_CLOUD_COVER=20

# Anomaly detection thresholds
NDVI_DELTA_THRESHOLD=-0.35
SWIR_THRESHOLD=0.25
MIN_CONTOUR_AREA=10000.0

# Risk scoring weights
AREA_WEIGHT=0.4
CONFIDENCE_WEIGHT=0.3
PROXIMITY_WEIGHT=0.3

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","https://skydump.vercel.app"]
EXTRA_ALLOWED_ORIGINS=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email (for alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@skydump.ai

# Webhook
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Export
EXPORT_DIR=./exports